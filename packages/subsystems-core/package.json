{
  "name": "@principal-ai/subsystems-core",
  "version": "0.30.0",
  "description": "Subsystem model types and agent-session tooling for Principal AI",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./pipeline": {
      "types": "./dist/opencode/pipeline.d.ts",
      "import": "./dist/opencode/pipeline.js",
      "require": "./dist/opencode/pipeline.js",
      "default": "./dist/opencode/pipeline.js"
    }
  },
  "files": [
    "dist",
    "src",
    "schemas",
    "README.md"
  ],
  "scripts": {
    "build": "bun run build:clean && bun run build:ts",
    "build:clean": "rm -rf dist",
    "build:ts": "tsc",
    "dev": "tsc --watch",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "lint": "cd ../.. && eslint packages/subsystems-core --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "cd ../.. && eslint packages/subsystems-core --ext .ts,.tsx,.js,.jsx --fix"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.0"
  },
  "peerDependencies": {
    "@principal-ai/agent-monitoring": "^0.3.43"
  },
  "devDependencies": {
    "@principal-ai/agent-monitoring": "^0.3.43",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "30.0.0",
    "jest": "30.1.3",
    "typescript": "5.0.4"
  },
  "keywords": [
    "subsystem-model",
    "agent-sessions",
    "principal-ai"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
