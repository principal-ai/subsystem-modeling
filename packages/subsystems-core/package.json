{
  "name": "@principal-ai/subsystems-core",
  "version": "0.29.0",
  "description": "Core logic and types for graph-based principal view framework",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./pipeline": {
      "types": "./dist/opencode/pipeline.d.ts",
      "import": "./dist/opencode/pipeline.js",
      "require": "./dist/opencode/pipeline.js",
      "default": "./dist/opencode/pipeline.js"
    }
  },
  "files": [
    "dist",
    "src",
    "schemas",
    "README.md"
  ],
  "scripts": {
    "build": "bun run build:clean && bun run build:ts",
    "build:clean": "rm -rf dist",
    "build:ts": "tsc",
    "dev": "tsc --watch",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "lint": "cd ../.. && eslint packages/subsystems-core --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "cd ../.. && eslint packages/subsystems-core --ext .ts,.tsx,.js,.jsx --fix"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.208.0",
    "@opentelemetry/otlp-transformer": "^0.211.0",
    "@opentelemetry/resources": "2.2.0",
    "@opentelemetry/sdk-trace-base": "2.2.0",
    "@opentelemetry/semantic-conventions": "1.38.0",
    "@principal-ai/repository-abstraction": "^0.5.7",
    "better-sqlite3": "^13.0.0",
    "date-fns": "3.0.0",
    "handlebars": "^4.7.8",
    "js-yaml": "4.1.0",
    "zod": "3.22.0"
  },
  "peerDependencies": {
    "@principal-ai/agent-monitoring": "^0.3.43",
    "@principal-ai/codebase-composition": "^0.2.43"
  },
  "devDependencies": {
    "@principal-ai/agent-monitoring": "^0.3.43",
    "@principal-ai/codebase-composition": "^0.2.43",
    "@types/better-sqlite3": "^7.6.13",
    "@types/handlebars": "^4.1.0",
    "@types/jest": "30.0.0",
    "@types/js-yaml": "4.0.9",
    "jest": "30.1.3",
    "typescript": "5.0.4"
  },
  "keywords": [
    "validation",
    "graph",
    "visualization",
    "testing",
    "event-driven"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
