{
  "name": "@principal-ai/principal-studio-cli",
  "version": "0.52.4",
  "description": "Principal AI CLI — subsystem models, Subsystems Studio, tours, and agent sessions",
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "bin": {
    "principal-ai": "dist/index.cjs"
  },
  "type": "module",
  "scripts": {
    "build": "bun run clean && bun run build:lib && bun run build:cli",
    "build:lib": "tsc -p tsconfig.build.json",
    "build:cli": "bun build/build-cli.ts",
    "clean": "rm -rf dist",
    "dev": "tsx src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepack": "bun run build"
  },
  "keywords": [
    "subsystem-model",
    "subsystems-studio",
    "cli",
    "principal-ai",
    "tours"
  ],
  "author": "Principal AI Team",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@pierre/diffs": "^1.6.4",
    "@principal-ai/agent-monitoring": "0.3.46",
    "@principal-ai/alexandria-core-library": "^0.4.0",
    "@principal-ai/codebase-composition": "^0.2.58",
    "@principal-ai/file-city-builder": "^0.5.5",
    "@principal-ai/repository-abstraction": "^0.5.7",
    "@principal-ai/subsystems-core": "^0.51.5",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.25.10",
    "ajv": "^8.20.0",
    "better-sqlite3": "^13.0.3",
    "chalk": "5.6.2",
    "commander": "14.0.3",
    "glob": "^13.0.7",
    "globby": "16.2.4",
    "js-yaml": "4.1.1"
  },
  "optionalDependencies": {
    "@principal-ai/subsystems-studio": "^0.20.17"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "1.4.4",
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
